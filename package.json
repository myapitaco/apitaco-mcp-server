{
  "name": "@apitaco/mcp-server",
  "version": "0.1.0",
  "description": "MCP (Model Context Protocol) server for Apitaco — query your balance, usage, and pricing from any MCP-compatible client (Claude Desktop, Cursor, Claude Code).",
  "keywords": [
    "mcp", "model-context-protocol", "claude", "anthropic",
    "apitaco", "ai", "llm", "claude-desktop"
  ],
  "homepage": "https://apitaco.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myapitaco/apitaco-mcp-server.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "apitaco-mcp-server": "./dist/index.js"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
